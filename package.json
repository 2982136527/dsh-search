{
  "name": "dsh-search",
  "version": "0.1.0",
  "description": "Model-callable web search for dsh without API keys: Bing RSS primary backend with DuckDuckGo fallback",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2982136527/dsh-search.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek",
    "deepseek-harness",
    "deepseek-ai",
    "cordis",
    "plugin",
    "ai-agent",
    "coding-agent",
    "search",
    "web-search",
    "bing",
    "duckduckgo"
  ]
}
